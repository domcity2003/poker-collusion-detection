"""Frozen configuration: lockbox check, then final fit and submission export.

Selected on development folds 1-4 before fold 0 was ever inspected:
  risk      rich pair table + hindsight, PU weights 8/1/0.15, CatBoost 550x5,
            pool blend .10
  behaviour multiclass over the three disclosed families, argmax over families
            only (predicting 'none' would zero the risk in every family's AP)
  evidence  three YetiRank specialists over policy + hindsight features,
            rank-normalised within pair and blended by predicted family
            probability. Binary relevance: grading by the organisers' own
            evidence_rank scored worse (.477 vs .500) because MAP@5 counts all
            five listed hands equally.
"""
import sys,json,argparse,time
from pathlib import Path
import numpy as np, pandas as pd, polars as pl
from catboost import CatBoostClassifier,CatBoostRanker,Pool
sys.path.insert(0,str(Path(__file__).resolve().parent))
from pipeline import pair_table,feature_columns,hand_table,pool_blend,FAM,ID
sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'reference'))
from official_metric import score as official_score,_average_precision

OUT=Path('artifacts/final');OUT.mkdir(parents=True,exist_ok=True)
def mat(df,cols):return np.nan_to_num(df.select(cols).to_numpy().astype('float32'),nan=0,posinf=1e6,neginf=-1e6)
def znorm(x,groups):
 out=np.empty_like(x)
 for idx in groups.values():
  b=x[idx];m=b.mean(0);s=b.std(0);s[s<1e-6]=1;out[idx]=(b-m)/s
 return out
def grouping(pair):
 g={}
 for i,p in enumerate(pair):g.setdefault(p,[]).append(i)
 return {k:np.array(v) for k,v in g.items()}

def fit_pair_models(df,cols,train):
 lab=df['label'].to_numpy();y=(lab==1).astype(int)
 # .15 not .04: the 136k unlabelled pairs are the population the metric
 # actually ranks over, and at .04 the 1.5k curated negatives still dominate
 # training. .15 beats .04 at every blend weight, so it is not a tuned artifact.
 w=np.where(lab==1,8.,np.where(lab==0,1.,.15))
 X=mat(df,cols)
 risk=CatBoostClassifier(iterations=550,depth=5,learning_rate=.055,l2_leaf_reg=8,thread_count=6,verbose=False,random_seed=2026,allow_writing_files=False)
 risk.fit(X[train],y[train],sample_weight=w[train])
 pos=train&(lab==1)
 fy=np.array([FAM.index(x) if x in FAM else -1 for x in df['behavior_family'].fill_null('none')])
 sel=pos&(fy>=0)
 beh=CatBoostClassifier(iterations=400,depth=4,learning_rate=.06,thread_count=6,verbose=False,random_seed=2026,allow_writing_files=False)
 beh.fit(X[sel],fy[sel])
 return risk,beh

def fit_evidence(train_mask=None):
 h=pl.read_parquet('artifacts/dev_hands_hindsight.parquet').filter(pl.col('label')==1).sort('pair_id')
 if train_mask is not None:h=h.filter(pl.Series(train_mask(h)))
 fc=[c for c,t in h.schema.items() if c not in ID and t.is_numeric()]
 X=mat(h,fc);y=h['ev'].to_numpy();pair=h['pair_id'].to_numpy();fam=h['behavior_family'].to_numpy()
 XX=np.hstack([X,znorm(X,grouping(pair))])
 gid=np.searchsorted(np.unique(pair),pair)
 models=[]
 for fm in FAM:
  s=fam==fm;o=np.argsort(gid[s],kind='stable');i=np.flatnonzero(s)[o]
  m=CatBoostRanker(loss_function='YetiRank',iterations=600,depth=5,learning_rate=.06,thread_count=6,verbose=False,random_seed=2026,allow_writing_files=False)
  m.fit(Pool(XX[i],y[i],group_id=gid[i]));models.append(m)
 return models,fc

def rank_hands(models,fc,h,probs):
 """Top five hand ids per pair, blended across the three family specialists."""
 X=mat(h,fc);pair=h['pair_id'].to_numpy();g=grouping(pair)
 XX=np.hstack([X,znorm(X,g)])
 spec=np.vstack([m.predict(XX) for m in models])
 hid=h['hand_id'].to_numpy();out={}
 for p,idx in g.items():
  w=probs.get(p,np.ones(3)/3);block=spec[:,idx]
  r=np.vstack([(np.argsort(np.argsort(b))+1)/len(b) for b in block])
  s=(w[:,None]*r).sum(0)
  out[p]=list(hid[idx][np.argsort(-s)[:5]])
 return out

def build(df,cols,risk,beh,models,fc,phase,pools):
 X=mat(df,cols)
 r=pool_blend(risk.predict_proba(X)[:,1],df['pool'].to_numpy())
 bp=beh.predict_proba(X)
 probs={p:v for p,v in zip(df['pair_id'],bp)}
 top={}
 pairs=df.select('pair_id','player_1','player_2','pool')
 for i,pool in enumerate(pools):
  pp=pairs.filter(pl.col('pool')==pool)
  if pp.height==0:continue
  top.update(rank_hands(models,fc,hand_table(phase,pool,pp),probs))
  if i%50==0:print('evidence pool',i,flush=True)
 sub=pd.DataFrame({'pair_id':df['pair_id'].to_list(),'risk_score':np.clip(r,0,1),
                   'predicted_behavior':[FAM[i] for i in bp.argmax(1)]})
 for k in range(5):
  sub[f'evidence_hand_{k+1}']=[top.get(p,[])[k] if len(top.get(p,[]))>k else 'NO_EVIDENCE' for p in sub.pair_id]
 return sub

def main():
 ap=argparse.ArgumentParser();ap.add_argument('--lockbox',action='store_true');args=ap.parse_args()
 t=time.time()
 dev=pair_table('development');cols=feature_columns(dev)
 Path('artifacts/final/feature_columns.json').write_text(json.dumps(cols,indent=2))
 fold=dev['fold'].to_numpy();lab=dev['label'].to_numpy()
 if args.lockbox:
  # Fold 0 has never been inspected. Risk is judged over every fold-0 candidate;
  # evidence and behaviour only over the labelled pairs, which is where the
  # official metric evaluates them anyway.
  train=fold!=0
  risk,beh=fit_pair_models(dev,cols,train)
  models,fc=fit_evidence(lambda h:h['fold'].to_numpy()!=0)
  test=dev.filter(pl.Series(fold==0))
  X=mat(test,cols)
  s0=pool_blend(risk.predict_proba(X)[:,1],test['pool'].to_numpy())
  y=(test['label'].to_numpy()==1).astype(int);known=test['label'].to_numpy()>=0
  labels=pl.read_parquet('artifacts/labels.parquet').filter(pl.col('fold')==0)
  evid=pl.read_csv('data/development_evidence.csv')
  bp=beh.predict_proba(X)
  lk=(test.select('player_1','player_2','pair_id')
        .join(labels.select('player_1','player_2',pl.col('pair_id').alias('lab_id')),on=['player_1','player_2']))
  probs={r['lab_id']:bp[i] for i,r in enumerate(test.iter_rows(named=True)) if False}
  m={r['pair_id']:r['lab_id'] for r in lk.iter_rows(named=True)}
  probs={m[p]:v for p,v in zip(test['pair_id'],bp) if p in m}
  risk_by={m[p]:v for p,v in zip(test['pair_id'],s0) if p in m}
  beh_by={m[p]:FAM[int(np.argmax(v))] for p,v in zip(test['pair_id'],bp) if p in m}
  top={}
  for pool in sorted(labels['pool'].unique().to_list()):
   pp=labels.filter(pl.col('pool')==pool).select('pair_id','player_1','player_2')
   top.update(rank_hands(models,fc,hand_table('development',pool,pp),probs))
  cur=pd.DataFrame({'pair_id':labels['pair_id'].to_list()})
  cur['risk_score']=[float(np.clip(risk_by.get(p,0),0,1)) for p in cur.pair_id]
  cur['predicted_behavior']=[beh_by.get(p,FAM[0]) for p in cur.pair_id]
  for k in range(5):
   cur[f'evidence_hand_{k+1}']=[top.get(p,[])[k] if len(top.get(p,[]))>k else 'NO_EVIDENCE' for p in cur.pair_id]
  sol=labels.select('pair_id',pl.col('label').alias('risk_score'),pl.col('behavior_family').alias('predicted_behavior')).to_pandas()
  for k in range(1,6):
   d=evid.filter(pl.col('evidence_rank')==k).select('pair_id',pl.col('hand_id').alias(f'evidence_hand_{k}')).to_pandas()
   sol=sol.merge(d,on='pair_id',how='left')
  sol=sol.fillna('NO_EVIDENCE')
  ly=sol.sort_values('pair_id').risk_score.to_numpy().astype(int)
  cs=cur.set_index('pair_id').loc[sol.sort_values('pair_id').pair_id]
  ev_scores=[]
  for i,p in enumerate(sol.sort_values('pair_id').pair_id):
   if ly[i]!=1:continue
   rel=set(x for x in sol.set_index('pair_id').loc[p,[f'evidence_hand_{k}' for k in range(1,6)]] if x!='NO_EVIDENCE')
   got=[x for x in cs.loc[p,[f'evidence_hand_{k}' for k in range(1,6)]] if x!='NO_EVIDENCE']
   hits=0;acc=0.
   for r,hh in enumerate(got[:5],1):
    if hh in rel:hits+=1;acc+=hits/r
   ev_scores.append(acc/min(len(rel),5) if rel else 0.)
  res={'official_labeled_only':official_score(sol,cur,'pair_id'),
       'broad_ap':_average_precision(y,s0),
       'labeled_ap':_average_precision(y[known],s0[known]),
       'evidence_map5':float(np.mean(ev_scores)),
       'n_candidates':int(test.height),'n_positives_broad':int(y.sum()),
       'n_labeled':int(labels.height),'seconds':round(time.time()-t)}
  res['estimated_eval_score']=.7*res['broad_ap']+.2*res['evidence_map5']+.1*(res['official_labeled_only']-.7*res['labeled_ap']-.2*res['evidence_map5'])/.1
  Path('reports/lockbox.json').write_text(json.dumps(res,indent=2))
  print(json.dumps(res,indent=2),flush=True);return
 risk,beh=fit_pair_models(dev,cols,np.ones(len(fold),bool))
 models,fc=fit_evidence()
 ev=pair_table('evaluation')
 missing=[c for c in cols if c not in ev.columns]
 assert not missing,missing
 sub=build(ev,cols,risk,beh,models,fc,'evaluation',sorted(ev['pool'].unique().to_list()))
 sub.to_csv('artifacts/final/submission.csv',index=False)
 print('submission rows',len(sub),'seconds',round(time.time()-t),flush=True)
if __name__=='__main__':main()
